{
  "project": "city-block",
  "type_override": {
    "primary": "environment",
    "modifiers": [
      "procedural"
    ],
    "ambiguous": false
  },
  "facts": {
    "subject_prefix": "GEO_src_",
    "subject_proxy": "PRX_city",
    "allow_ngons": true,
    "hero_camera": "CAM_hero",
    "cameras": [
      "CAM_hero"
    ],
    "resolution": [
      960,
      540
    ],
    "frame_objects": [
      "GEO_city",
      "GEO_main_road",
      "GEO_park"
    ],
    "min_fill": 0.3,
    "frame_margin": 0.0,
    "exposure": {
      "max_clipped": 0.03,
      "mean_min": 0.15,
      "mean_max": 0.5
    }
  },
  "assumptions": [
    "3 x 3 lots of 8 m with 4 m alleys (32 m square block) centred on the origin",
    "street along Y west of the block, park south of it (towards camera); terrain flat inside 45 m",
    "trees and lamps are simple stand-ins for previs, instanced by geometry nodes",
    "model checks target the instance sources (GEO_src_*); open meshes (terrain, street lines) are not held to closed-mesh checks"
  ],
  "roles": {
    "blockout": {
      "ops": [
        {
          "op": "setup_scene",
          "args": {
            "frame_range": [
              1,
              1
