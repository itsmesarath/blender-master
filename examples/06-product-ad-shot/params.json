              0.104,
              0.104,
              0.16
            ],
            "note": "speaker"
          }
        },
        {
          "op": "camera",
          "args": {
            "name": "CAM_hero",
            "lens": 50,
            "location": [
              0.0,
              -1.0,
              0.32
