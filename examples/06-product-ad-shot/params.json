          "op": "assign",
          "args": {
            "material": "collider",
            "targets": [
              "GEO_collider"
            ]
          }
        }
      ]
    },
    "simulation": {
      "ops": [
        {
          "op": "rigid_world",
          "args": {
            "substeps": 10,
            "iterations": 10,
            "frame_start": 40,
            "frame_end": 108
          }
        },
        {
          "op": "rigid_body",
          "args": {
            "targets": "GEO_pebble_",
            "kind": "ACTIVE",
            "shape": "SPHERE",
            "mass": 0.05,
            "friction": 0.6,
            "bounciness": 0.3,
            "damping": 0.2
          }
        },
        {
          "op": "rigid_body",
          "args": {
            "targets": [
              "GEO_collider",
              "GEO_spk_body"
            ],
            "kind": "PASSIVE",
            "shape": "MESH"
          }
        },
        {
          "op": "bake",
          "args": {
            "frame_end": 108
          }
        }
      ],
      "acceptance_extra": [
        {
          "check": "sim_settled",
          "args": {
            "objects": "GEO_pebble_"
          },
          "desc": "pebbles come to rest"
        }
      ]
