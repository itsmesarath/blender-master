{
  "project": "speaker-ad",
  "type_override": {
    "primary": "product_shot",
    "modifiers": [
      "vfx_sim"
    ],
    "ambiguous": false
  },
  "add_roles": [
    "edit"
  ],
  "facts": {
    "subject_prefix": "GEO_spk_",
    "subject_proxy": "PRX_spk",
    "subject_size": [
      0.104,
      0.104,
      0.16
    ],
    "hero_camera": "CAM_hero",
    "cameras": [
      "CAM_hero"
    ],
    "resolution": [
      640,
      360
    ],
    "min_fill": 0.05,
    "frame_margin": 0.02,
    "sim_objects": "GEO_pebble_",
    "fps": 24,
    "video": "video/ad.mp4",
    "video_audio": true,
    "exposure": {
      "max_clipped": 0.05
    }
  },
  "assumptions": [
    "speaker 10.4 cm wide, 16 cm tall; pebbles 2-2.5 cm",
    "the cloth settles over the speaker during a 24-frame pre-roll that is simulated but not rendered; frames 25-108 make the 3.5 s cut (reveal from 36, pebbles from 40, logo 66-86, end card from 94)",
    "the sound is a generated placeholder tone; swap in licensed music for delivery",
    "a hidden collider box under the sweep floor catches the pebbles (the sweep itself is rebuilt by the studio op)"
  ],
  "roles": {
    "blockout": {
      "ops": [
        {
          "op": "setup_scene",
          "args": {
            "fps": 24,
            "frame_range": [
              1,
              108
            ]
          }
        },
        {
          "op": "resolution",
          "args": {
            "res": [
              640,
              360
            ]
          }
        },
        {
          "op": "proxy",
          "args": {
            "name": "PRX_spk",
            "shape": "cylinder",
